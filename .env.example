# Copy sang .env rồi chỉnh. .env không được commit.
#
# Danh sách này phải khớp với `src/config/env.schema.ts` — schema mới là nguồn
# sự thật, file này chỉ là tài liệu. Biến nào không có default trong schema là
# BẮT BUỘC: thiếu nó, process thoát với exit code 1 ngay lúc boot.

# development | test | production. Quyết định format log (pretty vs JSON).
NODE_ENV=development

# Cổng HTTP server lắng nghe. Phải là số 1..65535.
PORT=3000

# 0.0.0.0 để container/pod bên ngoài gọi vào được. Dùng 127.0.0.1 nếu chỉ chạy local.
HOST=0.0.0.0

# Tiền tố cho mọi route nghiệp vụ. /health luôn nằm ngoài tiền tố này.
API_PREFIX=api

# BẮT BUỘC — không có default. Phải là postgres:// hoặc postgresql://
DATABASE_URL=postgres://starci:starci@localhost:5432/starci_shop

# BẮT BUỘC — tối thiểu 32 ký tự. Sinh bằng: openssl rand -hex 32
JWT_SECRET=thay-bang-mot-chuoi-ngau-nhien-that-su-dai-hon-32-ky-tu

# silent | fatal | error | warn | info | debug | trace
LOG_LEVEL=info
