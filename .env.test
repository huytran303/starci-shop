# Env cho test — file này ĐƯỢC commit, và chỉ chứa giá trị giả.
#
# Lý do tồn tại: config được validate fail-fast, nên test nào dựng
# `AppConfigModule` sẽ chết ngay nếu thiếu biến. Không có file này thì một
# clone mới chạy `pnpm test` sẽ fail vì `.env` (không commit) chưa tồn tại.
#
# NODE_ENV=test nên `ConfigModule` tự đọc `.env.test` trước `.env`.

NODE_ENV=test
PORT=3000
HOST=127.0.0.1
API_PREFIX=api

# Không trỏ tới DB thật — test hiện chưa mở connection nào.
DATABASE_URL=postgres://test:test@localhost:5432/starci_shop_test

# Giá trị giả, đủ 32 ký tự để qua schema. KHÔNG dùng ở bất kỳ đâu khác.
JWT_SECRET=test-only-secret-khong-dung-o-dau-khac

# Test không cần log ồn; đổi thành debug khi cần soi.
LOG_LEVEL=silent
